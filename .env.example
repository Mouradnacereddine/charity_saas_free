# Copier vers .env.local et renseigner les valeurs réelles (jamais commité).
# Placeholders vides — les vraies valeurs vivent uniquement dans .env.local.

# --- Base de données (Neon/PostgreSQL) ---
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Auth JWT ---
JWT_SECRET=
JWT_REFRESH_SECRET=

# --- Frontend ---
FRONTEND_URL=http://localhost:5173

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_CLIENT_ID=

# --- LemonSqueezy (tip jar « don au développeur ») ---
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=453836
LEMONSQUEEZY_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
# Devise du store 453836 (vérifiée : DZD). Valeurs possibles : DZD | EUR.
LEMONSQUEEZY_CURRENCY=DZD